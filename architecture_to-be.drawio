        <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="BionicPRO — C4 Container Diagram: Identity &amp; Access Management" vertex="1">
          <mxGeometry height="35" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=11;" value="&lt;b&gt;Пилот протеза&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Пользователь протеза.&lt;br&gt;Выполняет донастройку." vertex="1">
          <mxGeometry height="110" width="175" x="60" y="65" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=11;" value="&lt;b&gt;Покупатель&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Приобретает протез&lt;br&gt;в интернет-магазине." vertex="1">
          <mxGeometry height="110" width="175" x="285" y="65" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=11;" value="&lt;b&gt;ML-инженер&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Разрабатывает и обновляет&lt;br&gt;ML-модели протезов." vertex="1">
          <mxGeometry height="110" width="175" x="510" y="65" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#ffffff;strokeColor=#052E56;fontSize=11;" value="&lt;b&gt;Оператор производства&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Управляет заказами&lt;br&gt;через CRM." vertex="1">
          <mxGeometry height="110" width="175" x="735" y="65" as="geometry" />
        </mxCell>
        <mxCell id="boundary" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;strokeWidth=2;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;align=left;spacingLeft=10;spacingTop=5;" value="BionicPRO [System Boundary]" vertex="1">
          <mxGeometry height="720" width="1200" x="40" y="235" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=11;" value="&lt;b&gt;Мобильное приложение&lt;/b&gt;&lt;br&gt;[Container: iOS / Android]&lt;br&gt;&lt;br&gt;Донастройка протеза.&lt;br&gt;Инициирует PKCE-flow&lt;br&gt;через BFF." vertex="1">
          <mxGeometry height="130" width="195" x="80" y="295" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007AB8;fontColor=#ffffff;strokeColor=#004D7A;fontSize=11;strokeWidth=2;" value="&lt;b&gt;BFF&lt;/b&gt;&lt;br&gt;[Container: Backend for Frontend]&lt;br&gt;&lt;br&gt;Ведёт PKCE-flow с Keycloak.&lt;br&gt;Хранит IdP-токены на сервере.&lt;br&gt;Выдаёт фронтенду сессию (cookie)." vertex="1">
          <mxGeometry height="130" width="215" x="325" y="295" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007AB8;fontColor=#ffffff;strokeColor=#004D7A;fontSize=11;strokeWidth=2;" value="&lt;b&gt;Keycloak&lt;/b&gt;&lt;br&gt;[Container: Identity Broker]&lt;br&gt;&lt;br&gt;Единая точка аутентификации.&lt;br&gt;Федерирует внешние IdP по странам.&lt;br&gt;Выдаёт JWT (access + refresh)." vertex="1">
          <mxGeometry height="130" width="215" x="590" y="295" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=11;" value="&lt;b&gt;Программа в чипе&lt;/b&gt;&lt;br&gt;[Container: C++, ESP32]&lt;br&gt;&lt;br&gt;Считывает миосигналы.&lt;br&gt;Распознаёт движения.&lt;br&gt;Отправляет телеметрию (4G)." vertex="1">
          <mxGeometry height="130" width="195" x="80" y="515" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#ffffff;strokeColor=#0B4884;fontSize=11;" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;[Container: Backend]&lt;br&gt;&lt;br&gt;Обрабатывает бизнес-запросы.&lt;br&gt;Валидирует JWT через Keycloak.&lt;br&gt;Применяет RBAC." vertex="1">
          <mxGeometry height="130" width="215" x="325" y="515" as="geometry" />
        </mxCell>
